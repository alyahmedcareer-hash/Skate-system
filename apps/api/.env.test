# KOSHK SKATE ERP — Test Environment Variables
# Used by vitest and test migration scripts

# Application
NODE_ENV=test
PORT=3001

# Database (MySQL / MariaDB) - ISOLATED TEST DB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=koshk_skate_test
DB_USER=root
DB_PASSWORD=1234

# Authentication - Deterministic Test Secrets
JWT_SECRET=TEST_SECRET_ACCESS
JWT_REFRESH_SECRET=TEST_SECRET_REFRESH

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS
CORS_ORIGIN=http://localhost:5173

# Seed Admin Credentials (used during db:seed:test)
SEED_ADMIN_EMAIL=admin@koshkskate.com
SEED_ADMIN_PASSWORD=Koshk@12345
